#!/usr/bin/env bash
set -euo pipefail

# pak — Project Automation Kit CLI
# Unified entry point for autonomous AI-assisted development.
#
# Usage:
#   pak install [path]          Install the kit into a project
#   pak setup [path]            Run the interactive setup wizard
#   pak run <issue>             Work on a specific issue
#   pak run                     Interactive task selection
#   pak watch                   Continuous autonomous mode
#   pak parallel [issues...]    Run multiple issues concurrently
#   pak dashboard [port]        Launch the web dashboard
#   pak status                  Show agent status
#   pak costs                   Show cost tracking
#   pak cleanup                 Remove stale worktrees
#   pak readiness               Assess repo AI-readiness
#   pak address-pr <pr>         Address PR review comments
#   pak maintain-pr <pr>        Rebase + sync PR
#   pak review-pr <pr>          Run automated review on PR
#   pak learn-from-pr <pr>      Ingest PR review feedback
#   pak investigate <issue>     Run investigation mode
#   pak memory <subcommand>     Manage agent memory
#   pak knowledge <subcommand>  Manage layered knowledge
#   pak invariants <subcommand> Manage invariant checks
#   pak help                    Show this help

PAK_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
AGENT_SCRIPT="$PAK_ROOT/agent/orchestrator.sh"
INSTALL_SCRIPT="$PAK_ROOT/agent/install.sh"
SETUP_SCRIPT="$PAK_ROOT/agent/setup-wizard.sh"

show_help() {
  cat <<'EOF'
pak — Project Automation Kit

Commands:
  install [path]            Install the kit into a project (default: current dir)
    --no-dashboard          Skip dashboard installation
    --update                Quick sync (script + personas only)

  setup [path]              Run the interactive setup wizard
    Scans project, asks preferences, generates configuration

  run [issue]               Work on a specific issue (or interactive selection)
  watch                     Continuous autonomous mode (priority scanner + backlog)
  parallel [issues...]      Run multiple issues concurrently

  dashboard [port]          Launch the web dashboard (default port: 8111)
  status                    Show agent status dashboard
  costs                     Show cost tracking summary

  address-pr <pr>           Address PR review comments
  maintain-pr <pr>          Rebase PR on main + sync description
  review-pr <pr>            Run automated reviewer on a PR
  learn-from-pr <pr>        Ingest PR review feedback into memory
  triage [issue]            Assess issues for autonomous suitability
  harden [issue]            Enrich issues with context, criteria, and re-triage
  investigate <issue>       Run investigation mode on an issue

  memory <subcommand>       Manage agent memory (search, prune, tags)
  knowledge <subcommand>    Manage layered knowledge (list, promote, demote)
  invariants <subcommand>   Manage invariant checks (list, check)

  readiness                 Assess + improve repo's AI-development readiness
  cleanup                   Remove stale worktrees (interactive)
  help                      Show this help

Global options:
  --project <path>          Specify project directory (default: current dir)

Examples:
  pak install ~/projects/my-app
  pak setup ~/projects/my-app
  pak run 42
  pak watch
  pak dashboard
EOF
}

# Resolve project directory from --project flag or default to cwd
PROJECT_DIR=""
REMAINING_ARGS=()

for arg in "$@"; do
  if [[ "$arg" == "--project" ]]; then
    PROJECT_DIR_NEXT=true
    continue
  fi
  if [[ "${PROJECT_DIR_NEXT:-}" == "true" ]]; then
    PROJECT_DIR="$arg"
    PROJECT_DIR_NEXT=false
    continue
  fi
  REMAINING_ARGS+=("$arg")
done

set -- "${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}"

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  install)
    TARGET="${1:-.}"
    shift 2>/dev/null || true
    cd "$TARGET"
    exec "$INSTALL_SCRIPT" "$@"
    ;;

  setup)
    TARGET="${1:-.}"
    shift 2>/dev/null || true
    cd "$TARGET"
    exec "$SETUP_SCRIPT" "$@"
    ;;

  run)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" "$@"
    ;;

  watch)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --watch "$@"
    ;;

  parallel)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --parallel "$@"
    ;;

  dashboard)
    PORT="${1:-8111}"
    if [[ -n "${PROJECT_DIR:-}" ]]; then
      DATA_DIR="$(cd "$PROJECT_DIR" && pwd)/.claude"
    else
      REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
      DATA_DIR="$REPO_ROOT/.claude"
    fi
    DASHBOARD_DIR="$PAK_ROOT/dashboard"

    if [[ ! -d "$DASHBOARD_DIR" ]]; then
      echo "Error: Dashboard not found at $DASHBOARD_DIR"
      exit 1
    fi

    # Ensure deps
    if [[ ! -d "$DASHBOARD_DIR/.venv" ]]; then
      echo "Installing dashboard dependencies..."
      python3 -m venv "$DASHBOARD_DIR/.venv"
      "$DASHBOARD_DIR/.venv/bin/pip" install -q -r "$DASHBOARD_DIR/requirements.txt"
    fi

    echo "Project Automation Kit — Dashboard"
    echo "  Data: $DATA_DIR"
    echo "  URL:  http://localhost:$PORT"
    echo ""

    cd "$DASHBOARD_DIR"
    AGENT_DATA_DIR="$DATA_DIR" .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$PORT"
    ;;

  status)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --status "$@"
    ;;

  costs)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --costs "$@"
    ;;

  address-pr)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --address-pr "$@"
    ;;

  maintain-pr)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --maintain-pr "$@"
    ;;

  review-pr)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --review-pr "$@"
    ;;

  learn-from-pr)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --learn-from-pr "$@"
    ;;

  triage)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --triage "$@"
    ;;

  harden)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --harden "$@"
    ;;

  investigate)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --investigate "$@"
    ;;

  memory)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --memory "$@"
    ;;

  knowledge)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --knowledge "$@"
    ;;

  invariants)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --invariants "$@"
    ;;

  readiness)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --readiness "$@"
    ;;

  cleanup)
    if [[ -n "${PROJECT_DIR:-}" ]]; then cd "$PROJECT_DIR"; fi
    exec "$AGENT_SCRIPT" --cleanup "$@"
    ;;

  help|--help|-h)
    show_help
    ;;

  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'pak help' for usage."
    exit 1
    ;;
esac
