<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    This is a reference template for the SOVA server launchd plist.
    The 'sova server install-service' command generates the actual plist file
    with proper paths substituted (replacing placeholders with absolute paths).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sova.server</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Update this path to your sova binary location -->
        <string>/usr/local/bin/sova</string>
        <string>server</string>
        <string>start</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8111</string>
        <string>--project</string>
        <!-- Update this to your project directory -->
        <string>/path/to/your/project</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SOVA_PROJECT_DIR</key>
        <string>/path/to/your/project</string>
        <!-- Uncomment for PostgreSQL team deployments -->
        <!-- <key>SOVA_DATABASE_URL</key> -->
        <!-- <string>postgresql://user:pass@localhost:5432/sova</string> -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Use persistent log directory instead of /tmp -->
    <!-- Note: ~ expansion works in launchd, but absolute paths are more explicit -->
    <key>StandardOutPath</key>
    <string>~/Library/Logs/sova/sova-server.log</string>

    <key>StandardErrorPath</key>
    <string>~/Library/Logs/sova/sova-server.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
