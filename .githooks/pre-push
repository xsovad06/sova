#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: mirrors the CI pipeline checks locally
# Matches: .github/workflows/ci.yml

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

errors=0

echo "=== Pre-push CI checks ==="

# 1. Linters: the same `make lint` CI's lint steps and `make check` run (ShellCheck on
# invariants/ and .github/scripts/, Ruff, dashboard JS including inline template
# scripts, import layering, whole-tree invariant scans), so the hook cannot drift
# from CI by re-implementing a subset of them.
echo ""
echo "[1/5] make lint..."
if make lint 2>&1; then
  echo "  PASS"
else
  echo "  FAIL"
  errors=$((errors + 1))
fi

# 2. Validate command frontmatter
echo ""
echo "[2/5] Command frontmatter..."
fm_errors=0
for f in sova/commands/data/commands/*.md; do
  name=$(basename "$f")
  # Single awk pass: check first line and extract required fields
  result=$(awk '
    NR==1 { if ($0 != "---") { print "NO_FRONTMATTER"; exit } next }
    /^---$/ { exit }
    /^(name|description|user-invocable):/ { found[$1]=1 }
    END {
      split("name: description: user-invocable:", required, " ")
      for (i in required) {
        if (!(required[i] in found)) print "MISSING " required[i]
      }
    }
  ' "$f")
  if [[ "$result" == "NO_FRONTMATTER" ]]; then
    echo "  ERROR: $name missing frontmatter opening ---"
    fm_errors=$((fm_errors + 1))
  elif [[ -n "$result" ]]; then
    while IFS= read -r line; do
      field="${line#MISSING }"
      field="${field%:}"
      echo "  ERROR: $name missing required field: $field"
      fm_errors=$((fm_errors + 1))
    done <<< "$result"
  fi
done
if [ "$fm_errors" -gt 0 ]; then
  echo "  FAIL ($fm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 3. File permissions (the same set CI checks)
echo ""
echo "[3/5] File permissions..."
perm_errors=0
for f in invariants/*.sh .github/scripts/*.sh; do
  if [ ! -x "$f" ]; then
    echo "  ERROR: $f is not executable"
    perm_errors=$((perm_errors + 1))
  fi
done
if [ "$perm_errors" -gt 0 ]; then
  echo "  FAIL ($perm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# Refresh origin/main so the diff-based invariants below (silent-revert-guard in
# particular, whose range is origin/main..HEAD) compare against the real base.
# A stale ref would count commits that already merged as part of this push. A
# failed fetch must not block the push: an offline developer gets the older base.
echo ""
echo "[*] Refreshing origin/main..."
if git fetch origin +main:refs/remotes/origin/main --quiet 2>/dev/null; then
  echo "  OK"
else
  echo "  SKIP (fetch failed; invariants will use the existing origin/main)"
fi

# 4. Invariant checks (mirrors CI invariants job)
echo ""
echo "[4/5] Invariants..."
inv_errors=0
for script in invariants/*.sh; do
  name=$(basename "$script" .sh)
  if bash "$script" . main 2>&1; then
    echo "    $name: PASS"
  else
    echo "    $name: FAIL"
    inv_errors=$((inv_errors + 1))
  fi
done
if [ "$inv_errors" -gt 0 ]; then
  echo "  FAIL ($inv_errors invariant(s) failed)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 5. Secrets scan (gitleaks). SKIP when not installed so contributors without
# the binary can still push; CI enforces it as a required check.
echo ""
echo "[5/5] Secrets scan (gitleaks)..."
if command -v gitleaks &>/dev/null; then
  # Scan git history (not the working tree) so gitignored real secrets
  # (.env, .claude/settings.local.json) are never read; the allowlist in
  # .gitleaks.toml suppresses known-safe test fixtures. --log-opts=HEAD scopes
  # the scan to the current branch's own history, matching CI's single-ref
  # checkout: without it, gitleaks enumerates every local branch reachable in
  # this repo's shared .git directory (including unrelated, unpushed worktree
  # branches), so a fixture on a sibling in-progress branch can block a push
  # on this one for a "leak" CI will never see.
  if gitleaks git "$REPO_ROOT" --log-opts="HEAD" --no-banner --redact --config "$REPO_ROOT/.gitleaks.toml"; then
    echo "  PASS"
  else
    echo "  FAIL (secrets detected, review the findings above)"
    errors=$((errors + 1))
  fi
else
  echo "  SKIP (gitleaks not installed)"
fi

echo ""
if [ "$errors" -gt 0 ]; then
  echo "=== BLOCKED: $errors check(s) failed. Fix before pushing. ==="
  exit 1
fi

echo "=== All checks passed ==="
