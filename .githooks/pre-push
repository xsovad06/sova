#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: mirrors the CI pipeline checks locally
# Matches: .github/workflows/ci.yml

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

errors=0

# Resolve ruff binary once
RUFF=""
if command -v ruff &>/dev/null; then
  RUFF="ruff"
elif [[ -x "dashboard/.venv/bin/ruff" ]]; then
  RUFF="dashboard/.venv/bin/ruff"
fi

run_ruff() {
  if [[ -z "$RUFF" ]]; then
    echo "  SKIP (ruff not installed)"
    return 0
  fi
  if $RUFF "$@" 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
}

echo "=== Pre-push CI checks ==="

# 1. ShellCheck
echo ""
echo "[1/5] ShellCheck..."
if command -v shellcheck &>/dev/null; then
  if shellcheck --severity=warning \
    pak \
    agent/*.sh \
    agent/adapters/*.sh \
    invariants/*.sh 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
else
  echo "  SKIP (shellcheck not installed)"
fi

# 2. Ruff lint
echo ""
echo "[2/5] Ruff check..."
run_ruff check dashboard/

# 3. Ruff format
echo ""
echo "[3/5] Ruff format..."
run_ruff format --check dashboard/

# 4. Validate command frontmatter
echo ""
echo "[4/5] Command frontmatter..."
fm_errors=0
for f in commands/*.md; do
  name=$(basename "$f")
  # Single awk pass: check first line and extract required fields
  result=$(awk '
    NR==1 { if ($0 != "---") { print "NO_FRONTMATTER"; exit } next }
    /^---$/ { exit }
    /^(name|description|user-invocable):/ { found[$1]=1 }
    END {
      split("name: description: user-invocable:", required, " ")
      for (i in required) {
        if (!(required[i] in found)) print "MISSING " required[i]
      }
    }
  ' "$f")
  if [[ "$result" == "NO_FRONTMATTER" ]]; then
    echo "  ERROR: $name missing frontmatter opening ---"
    fm_errors=$((fm_errors + 1))
  elif [[ -n "$result" ]]; then
    while IFS= read -r line; do
      field="${line#MISSING }"
      field="${field%:}"
      echo "  ERROR: $name missing required field: $field"
      fm_errors=$((fm_errors + 1))
    done <<< "$result"
  fi
done
if [ "$fm_errors" -gt 0 ]; then
  echo "  FAIL ($fm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 5. File permissions
echo ""
echo "[5/5] File permissions..."
perm_errors=0
for f in pak agent/*.sh agent/adapters/*.sh invariants/*.sh; do
  if [ ! -x "$f" ]; then
    echo "  ERROR: $f is not executable"
    perm_errors=$((perm_errors + 1))
  fi
done
if [ "$perm_errors" -gt 0 ]; then
  echo "  FAIL ($perm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

echo ""
if [ "$errors" -gt 0 ]; then
  echo "=== BLOCKED: $errors check(s) failed. Fix before pushing. ==="
  exit 1
fi

echo "=== All checks passed ==="
