#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: mirrors the CI pipeline checks locally
# Matches: .github/workflows/ci.yml

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

errors=0

# Resolve ruff binary once
RUFF=""
if command -v ruff &>/dev/null; then
  RUFF="ruff"
elif [[ -x ".venv/bin/ruff" ]]; then
  RUFF=".venv/bin/ruff"
else
  _user_bin="$(python3 -m site --user-base 2>/dev/null)/bin"
  if [[ -x "$_user_bin/ruff" ]]; then
    RUFF="$_user_bin/ruff"
  fi
fi

run_ruff() {
  if [[ -z "$RUFF" ]]; then
    echo "  SKIP (ruff not installed)"
    return 0
  fi
  if $RUFF "$@" 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
}

echo "=== Pre-push CI checks ==="

# 1. ShellCheck
echo ""
echo "[1/7] ShellCheck..."
if command -v shellcheck &>/dev/null; then
  if shellcheck --severity=warning \
    invariants/*.sh 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
else
  echo "  SKIP (shellcheck not installed)"
fi

# 2. Ruff lint
echo ""
echo "[2/7] Ruff check..."
run_ruff check sova/ tests/

# 3. Ruff format
echo ""
echo "[3/7] Ruff format..."
run_ruff format --check sova/ tests/

# 4. Validate command frontmatter
echo ""
echo "[4/7] Command frontmatter..."
fm_errors=0
for f in commands/*.md; do
  name=$(basename "$f")
  # Single awk pass: check first line and extract required fields
  result=$(awk '
    NR==1 { if ($0 != "---") { print "NO_FRONTMATTER"; exit } next }
    /^---$/ { exit }
    /^(name|description|user-invocable):/ { found[$1]=1 }
    END {
      split("name: description: user-invocable:", required, " ")
      for (i in required) {
        if (!(required[i] in found)) print "MISSING " required[i]
      }
    }
  ' "$f")
  if [[ "$result" == "NO_FRONTMATTER" ]]; then
    echo "  ERROR: $name missing frontmatter opening ---"
    fm_errors=$((fm_errors + 1))
  elif [[ -n "$result" ]]; then
    while IFS= read -r line; do
      field="${line#MISSING }"
      field="${field%:}"
      echo "  ERROR: $name missing required field: $field"
      fm_errors=$((fm_errors + 1))
    done <<< "$result"
  fi
done
if [ "$fm_errors" -gt 0 ]; then
  echo "  FAIL ($fm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 5. File permissions
echo ""
echo "[5/7] File permissions..."
perm_errors=0
for f in invariants/*.sh; do
  if [ ! -x "$f" ]; then
    echo "  ERROR: $f is not executable"
    perm_errors=$((perm_errors + 1))
  fi
done
if [ "$perm_errors" -gt 0 ]; then
  echo "  FAIL ($perm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 6. Invariant checks (mirrors CI invariants job)
echo ""
echo "[6/7] Invariants..."
inv_errors=0
for script in invariants/*.sh; do
  name=$(basename "$script" .sh)
  if bash "$script" . main 2>&1; then
    echo "    $name: PASS"
  else
    echo "    $name: FAIL"
    inv_errors=$((inv_errors + 1))
  fi
done
if [ "$inv_errors" -gt 0 ]; then
  echo "  FAIL ($inv_errors invariant(s) failed)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 7. Secrets scan (gitleaks). SKIP when not installed so contributors without
# the binary can still push; CI enforces it as a required check.
echo ""
echo "[7/7] Secrets scan (gitleaks)..."
if command -v gitleaks &>/dev/null; then
  # Scan git history (not the working tree) so gitignored real secrets
  # (.env, .claude/settings.local.json) are never read; the allowlist in
  # .gitleaks.toml suppresses known-safe test fixtures.
  if gitleaks git "$REPO_ROOT" --no-banner --redact --config "$REPO_ROOT/.gitleaks.toml"; then
    echo "  PASS"
  else
    echo "  FAIL (secrets detected -- review the findings above)"
    errors=$((errors + 1))
  fi
else
  echo "  SKIP (gitleaks not installed)"
fi

echo ""
if [ "$errors" -gt 0 ]; then
  echo "=== BLOCKED: $errors check(s) failed. Fix before pushing. ==="
  exit 1
fi

echo "=== All checks passed ==="
