#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: mirrors the CI pipeline checks locally
# Matches: .github/workflows/ci.yml

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

errors=0

echo "=== Pre-push CI checks ==="

# 1. ShellCheck
echo ""
echo "[1/5] ShellCheck..."
if command -v shellcheck &>/dev/null; then
  if shellcheck --severity=warning \
    pak \
    agent/*.sh \
    agent/adapters/*.sh \
    invariants/*.sh 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
else
  echo "  SKIP (shellcheck not installed)"
fi

# 2. Ruff lint
echo ""
echo "[2/5] Ruff check..."
if command -v ruff &>/dev/null; then
  if ruff check dashboard/ 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
else
  if [[ -x "dashboard/.venv/bin/ruff" ]]; then
    if dashboard/.venv/bin/ruff check dashboard/ 2>&1; then
      echo "  PASS"
    else
      echo "  FAIL"
      errors=$((errors + 1))
    fi
  else
    echo "  SKIP (ruff not installed)"
  fi
fi

# 3. Ruff format
echo ""
echo "[3/5] Ruff format..."
if command -v ruff &>/dev/null; then
  if ruff format --check dashboard/ 2>&1; then
    echo "  PASS"
  else
    echo "  FAIL"
    errors=$((errors + 1))
  fi
else
  if [[ -x "dashboard/.venv/bin/ruff" ]]; then
    if dashboard/.venv/bin/ruff format --check dashboard/ 2>&1; then
      echo "  PASS"
    else
      echo "  FAIL"
      errors=$((errors + 1))
    fi
  else
    echo "  SKIP (ruff not installed)"
  fi
fi

# 4. Validate command frontmatter
echo ""
echo "[4/5] Command frontmatter..."
fm_errors=0
for f in commands/*.md; do
  name=$(basename "$f")
  if ! head -1 "$f" | grep -q '^---$'; then
    echo "  ERROR: $name missing frontmatter opening ---"
    fm_errors=$((fm_errors + 1))
    continue
  fi
  frontmatter=$(awk 'NR==1{next} /^---$/{exit} {print}' "$f")
  for field in name description user-invocable; do
    if ! echo "$frontmatter" | grep -q "^${field}:"; then
      echo "  ERROR: $name missing required field: $field"
      fm_errors=$((fm_errors + 1))
    fi
  done
done
if [ "$fm_errors" -gt 0 ]; then
  echo "  FAIL ($fm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

# 5. File permissions
echo ""
echo "[5/5] File permissions..."
perm_errors=0
for f in pak agent/*.sh agent/adapters/*.sh invariants/*.sh; do
  if [ ! -x "$f" ]; then
    echo "  ERROR: $f is not executable"
    perm_errors=$((perm_errors + 1))
  fi
done
if [ "$perm_errors" -gt 0 ]; then
  echo "  FAIL ($perm_errors errors)"
  errors=$((errors + 1))
else
  echo "  PASS"
fi

echo ""
if [ "$errors" -gt 0 ]; then
  echo "=== BLOCKED: $errors check(s) failed. Fix before pushing. ==="
  exit 1
fi

echo "=== All checks passed ==="
