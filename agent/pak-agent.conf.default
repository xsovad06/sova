# Project Automation Kit — Configuration
# Copy to pak-agent.conf to customize (auto-created on first run)
# Or run: pak setup  (interactive wizard)

# ─── Task Source ─────────────────────────────────────────────────────────────

# Task source: github | jira | linear | manual
TASK_SOURCE="github"

# Source-specific config (JIRA project key, Linear team key, etc.)
TASK_SOURCE_CONFIG=""

# ─── Project Settings ─────────────────────────────────────────────────────────

# GitHub repo (owner/name) for PR creation
GITHUB_REPO=""

# GitHub user (for auth switching)
GITHUB_USER=""

# Test command (run from worktree directory)
TEST_CMD="make test"

# Lint command (run from worktree directory)
LINT_CMD="make lint"

# Format command (run from worktree directory)
FORMAT_CMD="make format"

# Base branch for PRs
BASE_BRANCH="main"

# ─── GitHub Issue Selection ───────────────────────────────────────────────────

# Current milestone to pull issues from (empty = all)
ISSUE_MILESTONE=""

# Labels to filter (comma-separated, empty = all)
ISSUE_LABELS=""

# ─── Persona Settings ─────────────────────────────────────────────────────

# Explicit repo-to-persona mapping (comma-separated, repo-name:persona-name)
# Leave empty for auto-detection from project files
PERSONA_MAP=""

# ─── Agent Settings ───────────────────────────────────────────────────────────

# Model to use: "opus" (smarter) or "sonnet" (faster, cheaper)
AGENT_MODEL="opus"

# Max spend per task in USD
MAX_BUDGET="10.00"

# ─── Workflow Settings ────────────────────────────────────────────────────────

# Skip manual testing step
SKIP_MANUAL_TEST="true"

# Auto-approve self-review fixes without showing diff
AUTO_APPROVE_FIXES="false"

# ─── Automated Review (Koda) ─────────────────────────────────────────────────

# Enable automated PR review after CI passes (step 8b/8c)
REVIEW_ENABLED="true"

# Max review-fix rounds before giving up (Koda reviews, agent fixes, repeat)
REVIEW_MAX_ROUNDS=2

# ─── CI Monitoring ───────────────────────────────────────────────────────────

# How often to poll CI checks (seconds)
CI_POLL_INTERVAL=60

# Max time to wait for CI (seconds)
CI_MAX_WAIT=600

# Pipe-separated regex of known flaky CI check names
FLAKY_CHECKS=""

# ─── Priority Scanner ──────────────────────────────────────────────────────

# Check GitHub PRs for CI failures and review comments during priority scan
SCANNER_GITHUB_CHECK="true"

# ─── Watch Mode ───────────────────────────────────────────────────────────

# Interval between cycles when previous cycle found work (seconds)
WATCH_INTERVAL_ACTIVE=300

# Interval between cycles when idle (seconds)
WATCH_INTERVAL_IDLE=1800

# Auto-select GitHub issues in watch mode (true = autonomous with veto window, false = skip backlog)
WATCH_AUTO_SELECT_ISSUES="true"

# Seconds to wait before starting auto-selected task (veto window for user)
WATCH_VETO_SECONDS=30

# ─── Worktree Settings ───────────────────────────────────────────────────────

# Files to copy into worktrees (comma-separated, gitignored but needed for dev)
WORKTREE_COPY_FILES=".env,.env.local"

# Auto-remove done worktrees older than N days
WORKTREE_TTL_DONE_DAYS=3

# Notify about paused worktrees older than N days
WORKTREE_TTL_PAUSED_DAYS=7

# ─── Knowledge & Invariants ──────────────────────────────────────────────────

# Shared knowledge directory (cross-project, team-level)
SHARED_KNOWLEDGE_DIR="$HOME/.claude/shared-knowledge"

# Invariants directory (machine-checkable constraints, run before push)
INVARIANTS_DIR=""  # empty = use $SCRIPT_DIR/invariants/

# Max parallel agents (for --parallel mode)
MAX_PARALLEL_AGENTS=2

# ─── Commit Settings ─────────────────────────────────────────────────────────

# No AI co-author in commits
NO_AI_COAUTHOR="false"

# Commit author (empty = use git config)
COMMIT_AUTHOR=""

# Commit format: "conventional" (type(scope): desc) or "freeform"
COMMIT_FORMAT="conventional"

# ─── PR Settings ─────────────────────────────────────────────────────────────

# PR title format: "conventional" or "freeform"
PR_TITLE_FORMAT="conventional"

# Auto-link issues in PR body ("Closes #N")
PR_AUTO_LINK_ISSUES="true"

# Branch naming: "conventional" (feat/fix/refactor-N-slug) or "freeform"
BRANCH_NAMING="conventional"

# ─── JIRA Settings (when TASK_SOURCE=jira) ───────────────────────────────────

JIRA_BASE_URL=""
JIRA_EMAIL=""
# JIRA_TOKEN should be set via environment variable, not in config file

# ─── Linear Settings (when TASK_SOURCE=linear) ──────────────────────────────

# LINEAR_API_KEY should be set via environment variable, not in config file

# ─── Notifications ──────────────────────────────────────────────────────────

# Slack channel name to reference in review-request messages (display only)
SLACK_CHANNEL=""
